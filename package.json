{
  "name": "assembly-lab",
  "author": "Christopher Snow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Assembly Lab. An interactive course that teaches a real instruction set by driving it, on a reusable learning platform.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "platform/*",
    "content"
  ],
  "scripts": {
    "dev": "npm run dev -w @al/course",
    "build": "npm run build -w @al/course",
    "preview": "npm run preview -w @al/course",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:educational": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "./scripts/check.sh",
    "check:real-tools": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/real-tools/check.mjs",
    "sync-platform": "node scripts/sync-platform.mjs",
    "icons": "node scripts/icons.mjs",
    "check:native": "python3 scripts/native/check.py"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
